# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Admin emails (comma-separated) - users who can access ?admin page
VITE_ADMIN_EMAILS=admin@example.com

# Jotform intake — optional. When set, public CTAs route new providers to the Jotform
# instead of the old auth + onboarding flow. See docs/jotform-intake.md for setup.
VITE_JOTFORM_NEW_INTAKE_URL=https://form.jotform.com/XXXXXXXXXXXXX

# PostHog product analytics — optional. When set, initializes PostHog on page load.
# Autocapture is scoped to clicks on <a>/<button> only; form inputs are masked.
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Edge function env (set via `supabase secrets set`, not in this file for production):
#   JOTFORM_WEBHOOK_SECRET=<random-32-byte-hex>
#   JOTFORM_NEW_INTAKE_FORM_ID=<jotform-form-id>
#   JOTFORM_UPDATE_FORM_ID=<jotform-form-id>   (Phase 3)
